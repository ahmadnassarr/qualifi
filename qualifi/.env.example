# Copy this file to .env and fill it in. Nothing here costs money.

# REQUIRED when the site is online: a long random value. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# (If empty, Qualifi creates one in instance/secret_key, which is fine as long as that file is kept.)
QUALIFI_SECRET_KEY=

# Set to 1 when the site is served over https (it should be, once public)
QUALIFI_HTTPS=0

# Set to 1 when a hosting proxy sits in front of the app (Render, Railway, Nginx, Caddy...)
QUALIFI_BEHIND_PROXY=0

# REQUIRED when online: the public address of the site. Used to build password-reset links in emails.
QUALIFI_BASE_URL=https://www.your-domain.com

# Email for "Forgot password". Any SMTP account works; free options:
#   Gmail:  host smtp.gmail.com, port 587, your address, and an "App password" (Google Account > Security)
#   Brevo:  host smtp-relay.brevo.com, port 587 (300 free emails/day)
# Leave QUALIFI_SMTP_HOST empty on your own computer: reset links are then printed in the terminal.
QUALIFI_SMTP_HOST=
QUALIFI_SMTP_PORT=587
QUALIFI_SMTP_USER=
QUALIFI_SMTP_PASSWORD=
QUALIFI_MAIL_FROM=Qualifi <no-reply@your-domain.com>

# ---- Sign in with Google / Apple / GitHub (optional; each button appears once its keys are filled in) ----
# Callback URLs to register with each provider:  <QUALIFI_BASE_URL>/auth/google/callback  (…/apple/…, …/github/…)
# Google: console.cloud.google.com > APIs & Services > Credentials > OAuth client ID (Web application)
QUALIFI_GOOGLE_CLIENT_ID=
QUALIFI_GOOGLE_CLIENT_SECRET=
# GitHub: github.com > Settings > Developer settings > OAuth Apps > New OAuth App
QUALIFI_GITHUB_CLIENT_ID=
QUALIFI_GITHUB_CLIENT_SECRET=
# Apple (needs a paid Apple Developer account and an https domain; doesn't work on localhost):
#   CLIENT_ID = your Services ID (e.g. com.yourname.qualifi.web), TEAM_ID = your 10-character Team ID,
#   KEY_ID = the ID of a "Sign in with Apple" key, and the downloaded .p8 key file
QUALIFI_APPLE_CLIENT_ID=
QUALIFI_APPLE_TEAM_ID=
QUALIFI_APPLE_KEY_ID=
QUALIFI_APPLE_PRIVATE_KEY_FILE=

# Where the database, uploads and logs are kept (default: the instance/ folder next to this file).
# On hosting with a persistent disk, point this at the disk, e.g. /var/data/qualifi
QUALIFI_DATA_DIR=

# Days a candidate waits before retaking a failed test (default 14)
QUALIFI_RETAKE_DAYS=14

# How many questions Qualifi builds from a company's documents; each candidate gets a random subset (default 40)
QUALIFI_QUESTIONS_TO_GENERATE=40
